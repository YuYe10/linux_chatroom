# =============================================================================
# Linux聊天室项目 - Makefile
# 功能：自动化编译服务器端和客户端程序
# =============================================================================

# -----------------------------------------------------------------------------
# 编译器设置
# -----------------------------------------------------------------------------
CC := gcc                                      # 使用gcc编译器
CFLAGS := -fPIC -no-pie -Wall -g              # 编译选项：
                                              # -fPIC: 生成位置无关代码
                                              # -no-pie: 禁用位置无关可执行文件
                                              # -Wall: 显示所有警告信息
                                              # -g: 包含调试信息

# -----------------------------------------------------------------------------
# 链接库配置
# -----------------------------------------------------------------------------
SERVER_LDFLAGS := -lpthread -lmysqlclient    # 服务器端链接库：
                                              # -lpthread: POSIX线程库
                                              # -lmysqlclient: MySQL客户端库

CLIENT_LDFLAGS := -lpthread                   # 客户端链接库：
                                              # -lpthread: POSIX线程库

NCURSE_LIBS := -lncurses                      # ncurses图形界面库
MENU_LIBS := -lmenu                           # 菜单库

# -----------------------------------------------------------------------------
# 源文件与目标文件配置
# -----------------------------------------------------------------------------
SERVER_OBJS := serverLogin.o database.o      # 服务器端目标文件：
                                              # serverLogin.o: 服务器登录模块
                                              # database.o: 数据库操作模块

CLIENT_OBJS := clientLogin.o                  # 客户端目标文件：
                                              # clientLogin.o: 客户端登录模块

# -----------------------------------------------------------------------------
# 伪目标声明
# 声明这些目标不是实际的文件，而是需要执行的操作
# -----------------------------------------------------------------------------
.PHONY: all server client clean

# -----------------------------------------------------------------------------
# 默认目标：编译服务器和客户端
# 执行命令：make 或 make all
# -----------------------------------------------------------------------------
all: server client

# -----------------------------------------------------------------------------
# 服务器编译规则
# 依赖：newServer.c源文件和所有服务器目标文件
# 生成：server可执行文件
# -----------------------------------------------------------------------------
server: newServer.c $(SERVER_OBJS)
	$(CC) $(CFLAGS) newServer.c $(SERVER_OBJS) -o server $(SERVER_LDFLAGS)

# -----------------------------------------------------------------------------
# 客户端编译规则
# 依赖：newClient.c源文件和所有客户端目标文件
# 生成：client可执行文件
# -----------------------------------------------------------------------------
client: newClient.c $(CLIENT_OBJS)
	$(CC) $(CFLAGS) newClient.c $(CLIENT_OBJS) -o client $(CLIENT_LDFLAGS) $(NCURSE_LIBS) $(MENU_LIBS)

# -----------------------------------------------------------------------------
# 服务器登录模块编译规则
# 依赖：serverLogin.c源文件和对应的头文件
# 生成：serverLogin.o目标文件
# -----------------------------------------------------------------------------
serverLogin.o: serverLogin.c serverLogin.h database.h
	$(CC) $(CFLAGS) -c serverLogin.c -o serverLogin.o

# -----------------------------------------------------------------------------
# 客户端登录模块编译规则
# 依赖：clientLogin.c源文件和对应的头文件
# 生成：clientLogin.o目标文件
# -----------------------------------------------------------------------------
clientLogin.o: clientLogin.c clientLogin.h
	$(CC) $(CFLAGS) -c clientLogin.c -o clientLogin.o

# -----------------------------------------------------------------------------
# 数据库模块编译规则
# 依赖：database.c源文件和对应的头文件
# 生成：database.o目标文件
# -----------------------------------------------------------------------------
database.o: database.c database.h
	$(CC) $(CFLAGS) -c database.c -o database.o

# -----------------------------------------------------------------------------
# 清理编译产物
# 删除所有目标文件和可执行文件
# 执行命令：make clean
# -----------------------------------------------------------------------------
clean:
	rm -f *.o server client